# Instagram Credentials
INSTAGRAM_BOT_USERNAME=your_username
INSTAGRAM_BOT_PASSWORD=your_password

# Instagram DM Settings
INSTAGRAM_DM_ENABLED=false
INSTAGRAM_DM_AUTO_RESPOND=false
DM_TIMEOUT_MS=30000
DM_CHECK_INTERVAL_MS=60000
MAX_DM_RESPONSES_PER_SESSION=10

# Browser Settings (chrome, safari, firefox)
BROWSER_TYPE=chrome
DM_TEST_KEEP_OPEN=false
DM_TEST_AUTO_RESPOND=false

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/instagram-bot

# Logging
LOG_LEVEL=info
 
# Web Server (optional)
WEB_SERVER_ENABLED=false
PORT=3000

# Deep-link bases (optional)
DOCS_BASE_URL=
REPO_URL=
REPO_MAIN_BRANCH=main
ARTIFACT_BASE_URL=
LOG_UI_BASE_URL=
PM2_DASHBOARD_URL=
LOG_DIR=./logs

# Trace webhooks (optional)
TRACE_WEBHOOK_URL=
TRACE_WEBHOOK_SECRET=

# Supabase Configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=your_anon_key_here
