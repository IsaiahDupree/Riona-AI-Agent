{
  "name": "riona-ai-agent",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsc && node build/index.js",
    "start:background": "tsc && node build/index.js --mode=background",
    "start:data": "tsc && node build/index.js --mode=data",
    "start:basic": "tsc && node build/basic-index.js",
    "dev": "tsc && node build/basic-index.js",
    "dev:api": "tsc && node -e \"process.env.PORT=process.env.PORT||'3849'; require('dotenv').config(); require('./build/server/app.js').startServer()\"",
    "dev:all": "concurrently -n api,web -c blue,magenta \"npm run dev:api\" \"npm run dev --prefix frontend\"",
    "build": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "build:all": "npm run build && npm run build:frontend",
    "train-model": "tsc && node build/Agent/training/Model.js",
    "train:link": "tsc && node build/Agent/training/WebsiteScraping.js",
    "train:audio": "tsc && node build/Agent/training/TrainWithAudio.js",
    "scheduler": "tsc && node build/scheduler.js",
    "threads": "tsc && node build/runThreads.js",
    "threads-scheduler": "tsc && node build/threads-scheduler.js",
    "test-instagram": "tsc && node -e \"require('./build/client/InstagramTest.js').runInstagramTest()\"",
    "test:dm": "tsc && node -e \"require('./build/client/InstagramDMTest.js').runDMTest()\"",
    "test:dm:safari": "tsc && BROWSER_TYPE=safari node -e \"require('./build/client/InstagramDMSafari.js').runSafariDMTest()\"",
    "test:dm:chrome": "tsc && BROWSER_TYPE=chrome node -e \"require('./build/client/InstagramDMSafari.js').runSafariDMTest()\"",
    "test:safari:dm": "tsc && node -e \"require('./build/client/SafariDMTest.js').runSafariDMTest()\"",
    "test:safari:dm:full": "tsc && node -e \"require('./build/client/SafariDMFullTest.js').runFullDMTest()\"",
    "test:sarah": "tsc && node -e \"require('./build/client/SafariDMSarahTest.js').runSarahTest()\"",
    "test:vision": "tsc && node -e \"require('./build/client/SafariVisionTest.js').runVisionTest()\"",
    "test:selectors": "tsc && node -e \"require('./build/client/SafariSelectorTest.js').runSelectorTest()\"",
    "test:sarah:direct": "tsc && node -e \"require('./build/client/SafariSarahDirectTest.js').runSarahDirectTest()\"",
    "extract:dms": "tsc && node -e \"require('./build/client/SafariDMExtractor.js').extractAllDMs()\"",
    "dm:profile": "tsc && node -e \"require('./build/client/SafariProfileDM.js').runProfileDMTest()\"",
    "dm:status": "tsc && node -e \"require('./build/client/SafariDMStatusTracker.js').runStatusTracker()\"",
    "dm:requests": "tsc && node -e \"require('./build/client/SafariRequestsProcessor.js').runRequestsProcessor()\"",
    "dm:accept": "tsc && node -e \"const name = process.argv[1] || 'Andrew Sandler'; require('./build/client/SafariRequestsProcessor.js').acceptSpecificRequest(name)\"",
    "dm": "tsc && node -e \"process.env.INSTAGRAM_DM_ENABLED='true'; require('./build/index.js')\"",
    "playwright:install": "npx playwright install webkit chromium",
    "test": "jest --maxWorkers=1",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:supabase": "tsc && node build/db/test-supabase.js",
    "test:schema": "jest tests/integration/comprehensive-schema.test.ts",
    "migrate:supabase": "tsc && node build/db/migrate.js",
    "start:unified": "node build/unified.js",
    "health": "curl http://localhost:3000/health || echo 'Server not running'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Riona-AI-Agent is an AI-powered automation tool designed to interact with various social media platforms.",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/generative-ai": "^0.21.0",
    "@supabase/supabase-js": "^2.78.0",
    "@types/ws": "^8.18.1",
    "axios": "^1.7.9",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "cron": "^3.5.0",
    "csv-parser": "^3.1.0",
    "dompurify": "^3.2.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fs-extra": "^11.3.0",
    "helmet": "^8.0.0",
    "instagram-private-api": "^1.46.1",
    "jsdom": "^26.0.0",
    "mammoth": "^1.9.0",
    "moment": "^2.30.1",
    "mongodb": "^6.13.1",
    "mongoose": "^8.1.3",
    "node-cron": "^3.0.3",
    "openai": "^4.85.4",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.49.1",
    "proxy-chain": "^2.4.0",
    "puppeteer": "^22.15.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-adblocker": "^2.13.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "request": "^2.88.2",
    "request-promise": "^4.2.6",
    "tesseract.js": "^6.0.0",
    "textract": "^2.5.0",
    "twitter-api-v2": "^1.19.0",
    "typescript": "^5.7.3",
    "user-agents": "^1.1.100",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.3",
    "youtube-transcript": "^1.2.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24.3.1",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.4",
    "@types/puppeteer": "^5.4.7",
    "@types/request": "^2.48.12",
    "@types/textract": "^2.4.5",
    "@types/user-agents": "^1.0.4",
    "concurrently": "^9.0.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2"
  }
}
